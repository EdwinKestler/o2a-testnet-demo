FROM rust:1.98.1-slim-bookworm@sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730

ARG O2A_UID=1000
ARG O2A_GID=1000
ARG SQLITE_ARCHIVE_VERSION=3530400
ARG SQLITE_VERSION=3.53.4
ARG SQLITE_SHA3_256=454e45f61c6bd75b7420e7190732dea03ce6639c63ada47bbc592f67fc340338

RUN set -eux; \
    apt-get update; \
    apt-get install --yes --no-install-recommends \
      build-essential ca-certificates clang cmake curl git gnupg jq libclang-dev \
      libssl-dev pkg-config python3 python3-venv; \
    rm --recursive --force /var/lib/apt/lists/*; \
    curl --fail --show-error --silent --location \
      "https://sqlite.org/2026/sqlite-autoconf-${SQLITE_ARCHIVE_VERSION}.tar.gz" \
      --output /tmp/sqlite.tar.gz; \
    python3 -c 'import hashlib, pathlib, sys; actual = hashlib.sha3_256(pathlib.Path("/tmp/sqlite.tar.gz").read_bytes()).hexdigest(); expected = sys.argv[1]; assert actual == expected, f"SQLite SHA3-256 mismatch: {actual}"' "${SQLITE_SHA3_256}"; \
    tar --extract --gzip --file /tmp/sqlite.tar.gz --directory /tmp; \
    cd "/tmp/sqlite-autoconf-${SQLITE_ARCHIVE_VERSION}"; \
    ./configure --prefix=/usr/local; \
    make --jobs="$(nproc)"; \
    make install; \
    ldconfig; \
    sqlite3 --version | grep --fixed-strings "${SQLITE_VERSION}"; \
    cd /; \
    rm --recursive --force /tmp/sqlite.tar.gz "/tmp/sqlite-autoconf-${SQLITE_ARCHIVE_VERSION}"; \
    cargo install --locked cargo-audit --version 0.22.2; \
    cargo install --locked cargo-deny --version 0.20.2; \
    groupadd --gid "${O2A_GID}" o2a; \
    useradd --uid "${O2A_UID}" --gid "${O2A_GID}" --create-home --shell /bin/bash o2a; \
    install --directory --owner "${O2A_UID}" --group "${O2A_GID}" /workspace /home/o2a/.cargo

ENV CARGO_HOME=/home/o2a/.cargo
ENV PATH=/home/o2a/.cargo/bin:/usr/local/cargo/bin:${PATH}

COPY dev/toolchain-profile.sh /etc/profile.d/o2a-toolchain.sh

RUN rustup component add rustfmt clippy

USER o2a
WORKDIR /workspace
CMD ["bash"]
