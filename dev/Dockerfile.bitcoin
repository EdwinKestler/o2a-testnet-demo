FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

ARG BITCOIN_VERSION=31.1
ARG BITCOIN_ARCHIVE=bitcoin-31.1-x86_64-linux-gnu.tar.gz
ARG BITCOIN_SHA256=b80d9c3e04da78fb6f0569685673418cf686fadba9042d926d13fb87ff503f9e

RUN set -eux; \
    apt-get update; \
    apt-get install --yes --no-install-recommends ca-certificates curl; \
    curl --fail --show-error --location \
      "https://bitcoincore.org/bin/bitcoin-core-${BITCOIN_VERSION}/${BITCOIN_ARCHIVE}" \
      --output "/tmp/${BITCOIN_ARCHIVE}"; \
    echo "${BITCOIN_SHA256}  /tmp/${BITCOIN_ARCHIVE}" | sha256sum --check --strict; \
    tar --extract --gzip --file "/tmp/${BITCOIN_ARCHIVE}" --directory /tmp; \
    install --mode 0755 "/tmp/bitcoin-${BITCOIN_VERSION}/bin/bitcoind" /usr/local/bin/bitcoind; \
    install --mode 0755 "/tmp/bitcoin-${BITCOIN_VERSION}/bin/bitcoin-cli" /usr/local/bin/bitcoin-cli; \
    rm --recursive --force "/tmp/${BITCOIN_ARCHIVE}" "/tmp/bitcoin-${BITCOIN_VERSION}"; \
    apt-get purge --yes --auto-remove curl; \
    rm --recursive --force /var/lib/apt/lists/*; \
    groupadd --gid 10001 bitcoin; \
    useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin bitcoin; \
    install --directory --owner 10001 --group 10001 /var/lib/bitcoin

COPY --chown=10001:10001 dev/bitcoin.conf /etc/bitcoin/bitcoin.conf

USER 10001:10001
VOLUME ["/var/lib/bitcoin"]
ENTRYPOINT ["bitcoind"]
CMD ["-conf=/etc/bitcoin/bitcoin.conf", "-datadir=/var/lib/bitcoin"]
